# PathPal Backend Environment Variables

# Overpass API endpoint (free public server, no key needed)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# OSMnx graph cache directory (relative to backend/)
GRAPH_CACHE_DIR=cache

# Mumbai bounding box (expand to cover more area if needed)
MUMBAI_NORTH=19.27
MUMBAI_SOUTH=18.89
MUMBAI_EAST=73.00
MUMBAI_WEST=72.77

# Network type: walk | drive | bike | all
OSM_NETWORK_TYPE=all

# CORS - origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000
